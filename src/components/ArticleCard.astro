---
import { formatDate, urlFor } from '../lib/sanity';
import type { SanityArticle } from '../lib/sanity';

interface Props {
  article: SanityArticle;
  href: string;
  readMoreLabel: string;
}

const { article, href, readMoreLabel } = Astro.props;
const imageUrl = article.mainImage?.asset
  ? urlFor(article.mainImage.asset).width(760).height(428).format('webp').url()
  : null;
---

<a href={href} class="article-card fade-in">
  <div class="article-card-media">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={article.mainImage?.alt || article.title}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="article-card-placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 19.5V5a2 2 0 0 1 2-2h11.5A2.5 2.5 0 0 1 20 5.5V21H6a2 2 0 0 1-2-1.5Z" />
            <path d="M8 7h8M8 11h8M8 15h5" />
          </svg>
        </div>
      )
    }
  </div>
  <div class="article-card-body">
    {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
    <h2>{article.title}</h2>
    {article.excerpt && <p>{article.excerpt}</p>}
    <span class="article-card-link">
      {readMoreLabel}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .article-card:hover {
    transform: translateY(-4px);
    border-color: rgba(232, 90, 32, 0.22);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.11);
  }
  .article-card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f4f6;
  }
  .article-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .article-card:hover .article-card-media img {
    transform: scale(1.04);
  }
  .article-card-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: rgba(15, 23, 42, 0.32);
    background:
      linear-gradient(135deg, rgba(232, 90, 32, 0.08), rgba(99, 91, 255, 0.08)),
      #f8fafc;
  }
  .article-card-placeholder svg {
    width: 56px;
    height: 56px;
  }
  .article-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 26px;
  }
  .article-card time {
    color: var(--color-accent-orange);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .article-card h2 {
    margin: 0;
    color: var(--color-text-dark);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.25;
  }
  .article-card p {
    margin: 0;
    color: var(--color-text-dark-secondary);
    line-height: 1.7;
  }
  .article-card-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    color: var(--color-accent-orange);
    font-weight: 700;
  }
  .article-card-link svg {
    transition: transform 0.2s ease;
  }
  .article-card:hover .article-card-link svg {
    transform: translateX(4px);
  }
</style>
