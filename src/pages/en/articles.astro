---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import en from '../../i18n/en.json';
import { getArticles } from '../../lib/sanity';

const t = en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = await getArticles('en');
---

<Layout lang="en">
  <section class="page-hero articles-hero">
    <div class="container">
      <p class="section-tag fade-in">{t.pageHero.articles.tag}</p>
      <h1 class="section-title fade-in">{t.pageHero.articles.title}</h1>
      <p class="fade-in">{t.pageHero.articles.subtitle}</p>
    </div>
  </section>

  <section class="section section-light articles-section">
    <div class="container">
      {
        articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map((article) => (
              <ArticleCard
                article={article}
                href={`${base}/en/articles/${article.routeSlug}`}
                readMoreLabel="Read news"
              />
            ))}
          </div>
        ) : (
          <div class="articles-empty fade-in">
            <h2>New articles coming soon</h2>
            <p>The latest Vietba Group articles will appear here.</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .articles-section {
    padding-top: 80px;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .articles-empty {
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 28px;
    text-align: center;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: #fff;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }
  .articles-empty h2 {
    margin-bottom: 12px;
    color: var(--color-text-dark);
  }
  .articles-empty p {
    color: var(--color-text-dark-secondary);
  }
  @media (max-width: 980px) {
    .articles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
