---
import Layout from '../../../layouts/Layout.astro';
import ArticleBody from '../../../components/ArticleBody.astro';
import { formatDate, getArticles, urlFor } from '../../../lib/sanity';

export async function getStaticPaths() {
  const articles = await getArticles('en');
  return articles.map((article) => ({
    params: { slug: article.routeSlug },
    props: { article },
  }));
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrl = article.mainImage?.asset
  ? urlFor(article.mainImage.asset).width(1400).format('webp').url()
  : null;
---

<Layout
  lang="en"
  title={article.seoTitle || `${article.title} | VietBa Group`}
  description={article.seoDescription || article.excerpt || article.title}
  image={imageUrl || undefined}
  type="article"
>
  <article>
    <header class="article-detail-hero">
      <div class="container">
        <a href={`${base}/en/articles`} class="article-back">News</a>
        {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
        <h1>{article.title}</h1>
        {article.excerpt && <p>{article.excerpt}</p>}
      </div>
    </header>

    {
      imageUrl && (
        <div class="container article-featured-image">
          <img src={imageUrl} alt={article.mainImage?.alt || article.title} loading="eager" decoding="async" />
          {article.mainImage?.caption && <p>{article.mainImage.caption}</p>}
        </div>
      )
    }

    <section class="section section-light article-content-section">
      <div class="container">
        <ArticleBody body={article.body} lang="en" />
      </div>
    </section>
  </article>
</Layout>

<style>
  .article-detail-hero {
    padding: 140px 0 56px;
    background: #fff;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .article-detail-hero::before {
    content: '';
    position: absolute;
    inset: -40% auto auto -20%;
    width: 60%;
    height: 180%;
    background: radial-gradient(ellipse, rgba(232,90,32,0.12), transparent 70%);
    pointer-events: none;
  }
  .article-detail-hero .container {
    position: relative;
    z-index: 1;
    max-width: 860px;
  }
  .article-back,
  .article-detail-hero time {
    display: inline-flex;
    margin-bottom: 18px;
    color: var(--color-accent-orange);
    font-size: 0.86rem;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0;
  }
  .article-detail-hero time::before {
    content: '/';
    margin: 0 10px;
    color: rgba(15, 23, 42, 0.28);
  }
  .article-detail-hero h1 {
    margin: 0 auto 20px;
    color: var(--color-text-dark);
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1.08;
  }
  .article-detail-hero p {
    max-width: 720px;
    margin: 0 auto;
    color: var(--color-text-dark-secondary);
    font-size: 1.12rem;
    line-height: 1.75;
  }
  .article-featured-image {
    margin-top: 36px;
    margin-bottom: 28px;
    max-width: 1060px;
  }
  .article-featured-image img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 20px 55px rgba(15, 23, 42, 0.14);
  }
  .article-featured-image p {
    margin-top: 10px;
    color: var(--color-text-light);
    font-size: 0.92rem;
    text-align: center;
  }
  .article-content-section {
    padding-top: 52px;
  }
</style>
