---
import Layout from '../../../layouts/Layout.astro';
import ServiceDetail from '../../../components/ServiceDetail.astro';
import en from '../../../i18n/en.json';
import { getServiceSeo } from '../../../data/serviceSeo';
const s = en.serviceDetail.communications;
const seo = getServiceSeo('en', 'communications');
const t = en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout lang="en" title={seo.title} description={seo.description} image={s.intro.image}>
  <ServiceDetail
    lang="en"
    sectionTag={s.sectionTag}
    title={s.title}
    subtitle={s.subtitle}
    intro={s.intro}
    achievements={s.achievements}
    highlights={s.highlights}
    gallery={s.gallery}
    ctaTitle={t.home.contactCta}
    ctaSub={t.home.contactCtaSub}
    ctaBtn={t.home.contactCtaBtn}
    ctaLink={`${base}/en/contact`}
  />
</Layout>
